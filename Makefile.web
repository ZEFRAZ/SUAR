# ─────────────────────────────────────────────────────────────────────────────
# Makefile.web — Build Proyek Mercusuar Raylib untuk Web (WebAssembly / HTML5)
# ─────────────────────────────────────────────────────────────────────────────

RAYLIB_SRC = C:/raylib/raylib/src

CC      = emcc
CFLAGS  = -Os -Wall -DPLATFORM_WEB \
          -I. \
          -I$(RAYLIB_SRC) \
          -Isrc/screens \
          -Isrc/ui \
          -Isrc/algo \
          -Isrc/objects

LDFLAGS = $(RAYLIB_SRC)/libraylib.web.a \
          -s USE_GLFW=3 \
          -s ALLOW_MEMORY_GROWTH=1 \
          -s TOTAL_MEMORY=67108864 \
          -s EXPORTED_RUNTIME_METHODS=ccall \
          --preload-file FredokaOne-Regular.ttf \
          --preload-file Starbim.ttf \
          --preload-file background.png \
          --preload-file background_pola2d.png \
          --preload-file icon.png \
          --preload-file bgm.mp3 \
          --shell-file shell_web.html

TARGET  = build_web/index.html

SRCS    = main.c \
          src/screens/menu.c \
          src/screens/animasi2d.c \
          src/screens/about.c \
          src/screens/guide.c \
          src/screens/pola2d.c \
          src/objects/kapal.c \
          src/objects/alam.c \
          src/objects/bangunan.c \
          src/ui/audio.c \
          src/ui/draw_helpers.c \
          src/ui/back_button.c \
          src/algo/bresenham.c \
          src/algo/dda.c \
          src/algo/midcircle.c \
          src/ui/hud.c

all: $(TARGET)

$(TARGET): $(SRCS)
	@if not exist build_web mkdir build_web
	$(CC) $(CFLAGS) -o $(TARGET) $(SRCS) $(LDFLAGS)
	@copy /Y icon.png build_web\icon.png >nul

clean:
	@if exist build_web rmdir /s /q build_web
